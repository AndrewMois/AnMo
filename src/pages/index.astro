---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../data/content';
import { site } from '../data/site';
---

<BaseLayout>
  <div class="inspection-spine" aria-hidden="true"><span></span></div>
  <header class="site-header">
    <a class="identity" href="#top" aria-label={`${site.name}, back to top`}>
      <span>{site.name}</span>
      <span>{site.role}</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          site.navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{content.hero.eyebrow}</p>
        <h1 id="hero-title" data-reveal>
          {content.hero.title}
          <span>{content.hero.titleContinuation}</span>
        </h1>
        <p class="hero-summary" data-reveal>{content.hero.summary}</p>
        <div class="hero-actions" aria-label="Introduction links" data-reveal>
          <a class="primary-action" href="#work">{content.hero.primaryAction}</a>
          <a href={`mailto:${site.email}`}>{content.hero.secondaryAction}</a>
          <a href={site.resumeUrl} download>Resume ↓</a>
        </div>
      </div>

      <figure class="hero-portrait" data-reveal>
        <div class="portrait-halo" aria-hidden="true"></div>
        <picture>
          <source
            type="image/avif"
            srcset="/images/andriy-portrait-1280.avif 1280w, /images/andriy-portrait-1920.avif 1920w"
            sizes="(max-width: 700px) 100vw, 44vw"
          />
          <source
            type="image/webp"
            srcset="/images/andriy-portrait-1280.webp 1280w, /images/andriy-portrait-1920.webp 1920w"
            sizes="(max-width: 700px) 100vw, 44vw"
          />
          <img
            src="/images/andriy-portrait-1920.jpg"
            alt="Andriy Moiseyenko outdoors"
            width="1920"
            height="2879"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </figure>

      <p class="hero-easter-egg" aria-hidden="true">{content.hero.easterEgg}</p>
    </section>

    <section class="practice section-shell" aria-labelledby="practice-title">
      <header class="section-heading" data-reveal>
        <p class="eyebrow">{content.practice.eyebrow}</p>
        <h2 id="practice-title">{content.practice.title}</h2>
      </header>
      <ol class="practice-grid">
        {
          content.practice.areas.map((area) => (
            <li data-reveal>
              <span>{area.index}</span>
              <h3>{area.title}</h3>
              <ul>
                {area.tools.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="work" id="work" aria-labelledby="work-title">
      <header class="work-heading section-shell" data-reveal>
        <p class="eyebrow">Professional work</p>
        <h2 id="work-title">The systems that needed more than a test script.</h2>
      </header>

      <div class="case-studies">
        {
          content.professionalCases.map((study, index) => (
            <article
              class:list={[
                'case-study',
                `case-study--${study.id}`,
                { 'case-study--dark': index === 0 }
              ]}
            >
              {study.id === 'bluwave-ai' && (
                <svg class="energy-trace" viewBox="0 0 920 260" aria-hidden="true">
                  <defs>
                    <linearGradient id="energy-line" x1="0" x2="1">
                      <stop offset="0" stop-color="#2457c5" stop-opacity="0" />
                      <stop offset="0.42" stop-color="#6f96f4" />
                      <stop offset="1" stop-color="#d7b66e" />
                    </linearGradient>
                  </defs>
                  <path d="M0 184 C95 184 112 148 192 151 S300 218 372 161 S467 66 546 116 S666 196 732 118 S829 52 920 78" />
                  <path
                    class="energy-trace-soft"
                    d="M0 211 C130 178 196 221 286 184 S421 72 520 143 S675 228 775 157 S855 103 920 112"
                  />
                </svg>
              )}

              <header class="case-header" data-reveal>
                <div>
                  <p class="case-index">Case {String(index + 1).padStart(2, '0')}</p>
                  <p class="case-marker">{study.marker}</p>
                </div>
                <p class="case-organization">
                  {study.id === 'canada-revenue-agency' && <span aria-label="Canada">🇨🇦</span>}
                  {study.organization}
                </p>
              </header>

              <div class="case-intro" data-reveal>
                <h3>{study.headline}</h3>
                <p>{study.introduction}</p>
              </div>

              <ol class="case-proof">
                {study.proof.map((item, proofIndex) => (
                  <li data-reveal>
                    <span>{String(proofIndex + 1).padStart(2, '0')}</span>
                    <p>{item}</p>
                  </li>
                ))}
              </ol>

              <ul class="case-stack" aria-label={`${study.organization} technologies`} data-reveal>
                {study.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="products section-shell" id="products" aria-labelledby="products-title">
      <header class="products-heading" data-reveal>
        <p class="eyebrow">Products I build</p>
        <h2 id="products-title">I don't only test products. I ship them.</h2>
      </header>

      <div class="product-grid">
        {
          content.products.map((product) => (
            <article class:list={['product-card', `product-card--${product.id}`]} data-reveal>
              <span class="product-index">{product.index}</span>
              <div>
                <h3>{product.title}</h3>
                <p class="product-kicker">{product.kicker}</p>
                <p>{product.description}</p>
                <ul>
                  {product.proof.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <a href={product.href} target="_blank" rel="noreferrer">
                  Visit live site <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about section-shell" id="about" aria-labelledby="about-title">
      <div data-reveal>
        <p class="eyebrow">{content.about.eyebrow}</p>
        <h2 id="about-title">{content.about.title}</h2>
      </div>
      <div class="about-copy" data-reveal>
        {content.about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  </main>

  <footer class="site-footer" id="contact">
    <p class="eyebrow" data-reveal>{content.contact.eyebrow}</p>
    <h2 data-reveal>{content.contact.title}</h2>
    <p data-reveal>{content.contact.body}</p>
    <a href={`mailto:${site.email}`} data-reveal>{site.email}</a>
    <nav class="footer-links" aria-label="Professional profiles" data-reveal>
      <ul>
        <li><a href={site.resumeUrl} download>Resume PDF ↓</a></li>
        {
          site.socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-meta" data-reveal>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span>Ottawa, Canada</span>
    </div>
  </footer>
</BaseLayout>
