---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const proofAreas = [
  'Automation architecture',
  'APIs and backend behaviour',
  'AI/ML system validation',
  'Performance and reliability',
  'Product development'
];
---

<BaseLayout>
  <header class="site-header">
    <a class="identity" href="#top" aria-label={`${site.name}, back to top`}>
      <span>{site.name}</span>
      <span>{site.role}</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {
          site.navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <p class="eyebrow">Quality engineering · Ottawa, Canada</p>
      <h1 id="hero-title">
        QA Automation Engineer <span>with a developer's perspective.</span>
      </h1>
      <p class="hero-summary">
        I build quality systems for products that need to be understood beyond the interface —
        across devices, APIs, backend behaviour, data flows, and ML-driven decisions.
      </p>
      <div class="hero-actions" aria-label="Introduction links">
        <a class="primary-action" href="#work">View selected work</a>
        <a href={`mailto:${site.email}`}>Start a conversation</a>
      </div>
    </section>

    <section class="proof" aria-label="Areas of practice">
      <ul>
        {
          proofAreas.map((area, index) => (
            <li>
              <span>0{index + 1}</span>
              {area}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="foundation-section" id="approach" aria-labelledby="approach-title">
      <p class="eyebrow">The system beneath the surface</p>
      <h2 id="approach-title">Understand. Locate risk. Apply pressure. Create evidence.</h2>
      <p>
        This foundation intentionally ships as semantic, static HTML. The complete quality
        narrative, case studies, visual system, and motion will be developed in their approved
        phases.
      </p>
    </section>

    <section class="foundation-section" id="work" aria-labelledby="work-title">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">Professional systems and products, presented with depth.</h2>
      <p>
        BluWave AI, Canada Revenue Agency, Young Mystic, Guided by Scent, and Alex Healing form the
        approved evidence set. No student-era project gallery will return.
      </p>
    </section>

    <section class="foundation-section" id="about" aria-labelledby="about-title">
      <p class="eyebrow">About</p>
      <h2 id="about-title">I test systems deeply because I know how to build them.</h2>
    </section>
  </main>

  <footer id="contact">
    <p>Have a complex system worth understanding?</p>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</BaseLayout>
